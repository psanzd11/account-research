# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it.

# Anthropic API key. REQUIRED.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------------------
# Optional connector / enrichment credentials
# -------------------------------------------------------------------------

# Apollo.io API key. When set, the Researcher pre-seeds Apollo's confirmed
# employment / company facts before running web_search.
# Get one at: https://app.apollo.io/#/settings/integrations/api
# APOLLO_API_KEY=apk_...

# Voyage AI API key. When set + USE_EMBEDDINGS_FOR_CITATIONS=1, the Author's
# semantic citation validator uses cross-language embeddings instead of
# Jaccard token overlap. Catches ES↔EN paraphrase reliably.
# Get one at: https://dash.voyageai.com/
# VOYAGE_API_KEY=pa-...
# USE_EMBEDDINGS_FOR_CITATIONS=1

# -------------------------------------------------------------------------
# Round 2 feature flags (default ON; set to 0/false to disable)
# -------------------------------------------------------------------------
# SOURCE_AUTHORITY_GATING=1
# MULTI_SOURCE_CORROBORATION=1
# REVIEWER_RIGOR=1
# REVIEWER_TIER1_MIN_PER_CATEGORY=2
# MAX_AGGREGATOR_SHARE=0.25

# -------------------------------------------------------------------------
# Storage / cache overrides
# -------------------------------------------------------------------------
# LEDGER_DB_URL=sqlite:///outputs/ledger.db
# WEB_CACHE_DIR=outputs/web_cache
