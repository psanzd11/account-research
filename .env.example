# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it.

# Anthropic API key. REQUIRED.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# -------------------------------------------------------------------------
# Optional connector / enrichment credentials
# -------------------------------------------------------------------------

# Apollo.io API key. When set, the Researcher pre-seeds Apollo's confirmed
# employment / company facts before running web_search.
# Get one at: https://app.apollo.io/#/settings/integrations/api
# APOLLO_API_KEY=apk_...

# Voyage AI API key. The Author's semantic citation validator uses Voyage
# cross-language embeddings by DEFAULT when this key is set — it catches
# ES↔EN paraphrase that Jaccard token overlap misses. Without the key the
# validator falls back to Jaccard with a one-time warning. To force the
# Jaccard path even when a key is set, see DISABLE_EMBEDDINGS_FOR_CITATIONS.
# Get one at: https://dash.voyageai.com/
# VOYAGE_API_KEY=pa-...

# Set to 1 to force Jaccard token-overlap citation validation even when
# VOYAGE_API_KEY is present (deterministic / offline-friendly).
# DISABLE_EMBEDDINGS_FOR_CITATIONS=0

# -------------------------------------------------------------------------
# Round 2 feature flags (default ON; set to 0/false to disable)
# -------------------------------------------------------------------------
# SOURCE_AUTHORITY_GATING=1
# MULTI_SOURCE_CORROBORATION=1
# REVIEWER_RIGOR=1
# REVIEWER_TIER1_MIN_PER_CATEGORY=2
# MAX_AGGREGATOR_SHARE=0.25

# -------------------------------------------------------------------------
# Storage / cache overrides
# -------------------------------------------------------------------------
# LEDGER_DB_URL=sqlite:///outputs/ledger.db
# WEB_CACHE_DIR=outputs/web_cache
